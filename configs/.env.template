# configs/.env — szablon. Skopiuj do configs/.env i uzupełnij wartości.
#   cp configs/.env.template configs/.env
# CLI wczytuje configs/.env automatycznie (albo bierze te same nazwy z env
# środowiska). Plik configs/.env jest w .gitignore i NIE trafia do repo.

# ── Brama LITELLM (configs/litellm.config.mjs, http://127.0.0.1:4000) ──
# Klucz do proxy LiteLLM.
LITELLM_KEY=

# ── Mostek CLIProxyAPI / Codex (configs/codex.config.mjs, http://127.0.0.1:8317) ──
# Token z ~/.config/cliproxyapi/config.yaml.
CLIPROXY_TOKEN=

# ── API Anthropic wprost (configs/claude.config.mjs) ──
# Wariant subskrypcyjny bierze poświadczenia z HOME i token bywa zbędny.
ANTHROPIC_AUTH_TOKEN=

# ── Opcjonalne ──
# Katalog repo testów (domyślnie ~/.local/share/greenproof/manual-*/tests-repo).
# GREENPROOF_TESTS_REPO=
